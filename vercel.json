-- ============================================================
-- FJ Smart Prompt Hub — Seeds de Prompts
-- 40 prompts reais distribuídos nas 5 categorias
-- Execute APÓS o schema principal
-- ============================================================

-- Captura os IDs das categorias para usar nos inserts
do $$
declare
  v_hotel      uuid;
  v_rh         uuid;
  v_marketing  uuid;
  v_lideranca  uuid;
  v_atendimento uuid;
begin

select id into v_hotel       from public.categories where slug = 'hotel';
select id into v_rh          from public.categories where slug = 'rh';
select id into v_marketing   from public.categories where slug = 'marketing';
select id into v_lideranca   from public.categories where slug = 'lideranca';
select id into v_atendimento from public.categories where slug = 'atendimento';

