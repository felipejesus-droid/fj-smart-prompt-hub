-- ============================================================
-- PROMPTS
-- Biblioteca principal
-- ============================================================
create table public.prompts (
  id            uuid primary key default uuid_generate_v4(),
  category_id   uuid references public.categories(id) on delete set null,
  author_id     uuid references public.profiles(id) on delete set null,

  title         text not null,
  description   text,
  prompt_text   text not null,
  tags          text[] default '{}',
  difficulty    text default 'fácil',         -- 'fácil' | 'médio' | 'avançado'

  is_public     boolean default true,
  is_featured   boolean default false,
  is_active     boolean default true,

  uses_count    integer default 0,
  rating_sum    numeric default 0,
  rating_count  integer default 0,
  rating_avg    numeric generated always as (
    case when rating_count = 0 then 0
    else round(rating_sum / rating_count, 1) end
  ) stored,

  created_at    timestamptz default now(),
  updated_at    timestamptz default now()
);

-- Índices
create index idx_prompts_category on public.prompts(category_id);
create index idx_prompts_tags on public.prompts using gin(tags);
create index idx_prompts_public on public.prompts(is_public, is_active);

-- RLS
alter table public.prompts enable row level security;

create policy "Prompts públicos visíveis para todos autenticados"
  on public.prompts for select
  to authenticated
  using (is_public = true and is_active = true);

create policy "Autor vê e edita seus prompts"
  on public.prompts for all
  using (author_id = auth.uid());

create policy "Admins têm acesso total"
  on public.prompts for all
  using (
    exists (
      select 1 from public.profiles
      where id = auth.uid() and role = 'admin'
    )
  );

-- ============================================================
-- FAVORITES
-- ============================================================
create table public.favorites (
  id          uuid primary key default uuid_generate_v4(),
  user_id     uuid references public.profiles(id) on delete cascade not null,
  prompt_id   uuid references public.prompts(id) on delete cascade not null,
  created_at  timestamptz default now(),
  unique(user_id, prompt_id)
);

-- Índice
create index idx_favorites_user on public.favorites(user_id);

-- RLS
alter table public.favorites enable row level security;

create policy "Usuário gerencia apenas seus próprios favoritos"
  on public.favorites for all
  using (user_id = auth.uid());

-- ============================================================
-- PROMPT_USAGE
-- Histórico de uso e analytics
-- ============================================================
create table public.prompt_usage (
  id              uuid primary key default uuid_generate_v4(),
  user_id         uuid references public.profiles(id) on delete cascade not null,
  prompt_id       uuid references public.prompts(id) on delete cascade not null,
  variables_used  jsonb,                      -- { "nome": "Felipe", "contexto": "..." }
  rating          integer check (rating between 1 and 5),
  used_at         timestamptz default now()
);

-- Índices
create index idx_usage_user on public.prompt_usage(user_id);
create index idx_usage_prompt on public.prompt_usage(prompt_id);
create index idx_usage_date on public.prompt_usage(used_at);

-- RLS
alter table public.prompt_usage enable row level security;

create policy "Usuário vê e cria apenas seu próprio histórico"
  on public.prompt_usage for all
  using (user_id = auth.uid());

-- Trigger: incrementar uses_count no prompt ao registrar uso
create or replace function public.increment_prompt_uses()
returns trigger language plpgsql security definer as $$
begin
  update public.prompts
  set uses_count = uses_count + 1
  where id = new.prompt_id;

  -- Atualiza rating se fornecido
  if new.rating is not null then
    update public.prompts
    set
      rating_sum   = rating_sum + new.rating,
      rating_count = rating_count + 1
    where id = new.prompt_id;
  end if;

  -- Atualiza total_uses e last_active no perfil
  update public.profiles
  set
    total_uses  = total_uses + 1,
    last_active = current_date
  where id = new.user_id;

  return new;
end;
$$;

create trigger on_prompt_used
  after insert on public.prompt_usage
  for each row execute procedure public.increment_prompt_uses();

-- ============================================================
-- CUSTOM_PROMPTS
-- Prompts criados pelo próprio usuário (Meu Espaço)
-- ============================================================
create table public.custom_prompts (
  id            uuid primary key default uuid_generate_v4(),
  user_id       uuid references public.profiles(id) on delete cascade not null,
  category_id   uuid references public.categories(id) on delete set null,

  title         text not null,
  description   text,
  prompt_text   text not null,
  tags          text[] default '{}',
  difficulty    text default 'fácil',
  is_shared     boolean default false,        -- compartilhar com equipe?

  uses_count    integer default 0,
  created_at    timestamptz default now(),
  updated_at    timestamptz default now()
);

-- RLS
alter table public.custom_prompts enable row level security;

create policy "Usuário gerencia apenas seus custom prompts"
  on public.custom_prompts for all
  using (user_id = auth.uid());

create policy "Custom prompts compartilhados são visíveis para todos"
  on public.custom_prompts for select
  to authenticated
  using (is_shared = true);

-- ============================================================
-- ACHIEVEMENTS
-- Gamificação
-- ============================================================
create table public.achievements (
  id          uuid primary key default uuid_generate_v4(),
  slug        text unique not null,
  label       text not null,
  description text,
  icon        text,
  condition   jsonb,                          -- { "type": "uses_count", "threshold": 100 }
